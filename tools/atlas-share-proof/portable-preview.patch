diff --git a/src/portable-plan-ui.js b/src/portable-plan-ui.js
new file mode 100644
index 0000000..a05f044
--- /dev/null
+++ b/src/portable-plan-ui.js
@@ -0,0 +1,87 @@
+import { buildCatalogAt, previewObservingPlan } from "./observing.js";
+import { decodePortablePlan, encodePortablePlan } from "./portable-plan.js";
+
+export function formatPortableTime(utc, timezone = Intl.DateTimeFormat().resolvedOptions().timeZone) {
+  const local = new Intl.DateTimeFormat("en", {
+    dateStyle: "medium",
+    timeStyle: "short",
+    timeZone: timezone,
+  }).format(new Date(utc));
+  return `UTC: ${utc} · Browser time (${timezone}): ${local}`;
+}
+
+export function previewPortableAtLocation(json, location) {
+  const recipe = decodePortablePlan(json);
+  const { startTimeUtc, audience, durationMinutes, targetIds, categoryRequirements } = recipe;
+  return previewObservingPlan(buildCatalogAt(startTimeUtc), {
+    context: { ...location, date: startTimeUtc },
+    previewId: "portable-readonly",
+    title: "Imported plan preview",
+    now: startTimeUtc,
+    audience,
+    durationMinutes,
+    targetIds,
+    categoryRequirements,
+    minAltitude: 0,
+  });
+}
+
+export function mountPortablePlanUi({ root, getPlan, getLocation }) {
+  const find = (id) => root.querySelector(`#${id}`);
+  const result = find("portableResult");
+  const targets = find("portableTargets");
+  const input = find("portableInput");
+  const outputGroup = find("portableOutputGroup");
+  const output = find("portableOutput");
+  const clearPreview = () => {
+    result.textContent = "";
+    targets.replaceChildren();
+  };
+  const clearExport = () => {
+    outputGroup.hidden = true;
+    output.value = "";
+    find("portableExportTime").textContent = "";
+  };
+  find("portableExport").addEventListener("click", () => {
+    clearPreview();
+    clearExport();
+    const plan = getPlan();
+    if (!plan) {
+      result.textContent = "Save a plan before creating a shareable copy.";
+      return;
+    }
+    try {
+      const json = encodePortablePlan(plan, buildCatalogAt(plan.context.date));
+      find("portableExportTime").textContent = formatPortableTime(decodePortablePlan(json).startTimeUtc);
+      output.value = json;
+      outputGroup.hidden = false;
+      output.focus();
+    } catch {
+      result.textContent = "Could not export this saved plan.";
+    }
+  });
+  input.addEventListener("input", clearPreview);
+  find("portableImport").addEventListener("click", () => {
+    clearPreview();
+    try {
+      const location = getLocation();
+      const preview = previewPortableAtLocation(input.value, location);
+      const place = location.locationName || "current observing location";
+      result.textContent = `${formatPortableTime(preview.context.date)}. Preview for ${place}, checked against the horizon only. No plan was saved or replaced.`;
+      for (const target of preview.targets) {
+        const row = root.ownerDocument.createElement("li");
+        row.textContent = `${target.name} · ${formatPortableTime(target.scheduledTime)}`;
+        targets.append(row);
+      }
+    } catch (error) {
+      result.textContent = `Cannot preview this plan at the current location: ${error.message}`;
+    }
+  });
+  const reset = () => {
+    clearPreview();
+    clearExport();
+    input.value = "";
+  };
+  root.addEventListener("toggle", () => { if (!root.open) reset(); });
+  return { close() { root.open = false; reset(); } };
+}
diff --git a/src/portable-plan.js b/src/portable-plan.js
new file mode 100644
index 0000000..c807cb1
--- /dev/null
+++ b/src/portable-plan.js
@@ -0,0 +1,74 @@
+import { AppError } from "./app-error.js";
+import { validateObservingPlan } from "./observing.js";
+
+export const PORTABLE_PLAN_FORMAT = "night-sky-atlas/plan-recipe";
+const MAX_JSON_LENGTH = 4096;
+const AUDIENCES = new Set(["child", "beginner", "general", "experienced"]);
+const CATEGORIES = ["planet", "bright_star", "deep_sky"];
+const KEYS = [
+  "format", "version", "startTimeUtc", "audience", "durationMinutes", "targetIds",
+  "categoryRequirements",
+];
+
+function invalid(message) {
+  return new AppError("INVALID_PORTABLE_PLAN", message);
+}
+
+function exactKeys(value, keys) {
+  return value !== null && typeof value === "object" && !Array.isArray(value) &&
+    Object.keys(value).length === keys.length && keys.every((key) => Object.hasOwn(value, key));
+}
+
+function isCanonicalUtcInstant(value) {
+  if (typeof value !== "string" || !/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z$/.test(value)) return false;
+  const date = new Date(value);
+  return Number.isFinite(date.getTime()) && date.toISOString() === value;
+}
+
+// This is an inert recipe, not a saved plan; applying it requires a new local preview.
+export function decodePortablePlan(json) {
+  if (typeof json !== "string" || json.length > MAX_JSON_LENGTH) {
+    throw invalid("Expected a portable plan JSON document of at most 4096 characters.");
+  }
+  let recipe;
+  try {
+    recipe = JSON.parse(json);
+  } catch {
+    throw invalid("The portable plan is not valid JSON.");
+  }
+
+  if (recipe?.format !== PORTABLE_PLAN_FORMAT) throw invalid("Unrecognized portable plan format.");
+  if (recipe.version !== 1) {
+    throw new AppError("UNSUPPORTED_PORTABLE_PLAN_VERSION", "This portable plan version is not supported.");
+  }
+  if (!exactKeys(recipe, KEYS) || !isCanonicalUtcInstant(recipe.startTimeUtc) ||
+      !AUDIENCES.has(recipe.audience) ||
+      !Number.isInteger(recipe.durationMinutes) || recipe.durationMinutes < 10 || recipe.durationMinutes > 180 ||
+      !Array.isArray(recipe.targetIds) || recipe.targetIds.length < 1 || recipe.targetIds.length > 12 ||
+      recipe.targetIds.length > recipe.durationMinutes ||
+      recipe.targetIds.some((id) => typeof id !== "string" || !/^[a-z0-9][a-z0-9-]{0,99}$/.test(id)) ||
+      new Set(recipe.targetIds).size !== recipe.targetIds.length ||
+      !exactKeys(recipe.categoryRequirements, CATEGORIES) ||
+      CATEGORIES.some((key) => !Number.isInteger(recipe.categoryRequirements[key]) ||
+        recipe.categoryRequirements[key] < 0 || recipe.categoryRequirements[key] > 12) ||
+      CATEGORIES.reduce((sum, key) => sum + recipe.categoryRequirements[key], 0) > recipe.targetIds.length) {
+    throw invalid("The portable plan contains unsupported fields or invalid plan values.");
+  }
+  return recipe;
+}
+
+export function encodePortablePlan(plan, catalog) {
+  const source = validateObservingPlan(plan, catalog);
+  const recipe = {
+    format: PORTABLE_PLAN_FORMAT,
+    version: 1,
+    startTimeUtc: new Date(source.context.date).toISOString(),
+    audience: source.audience,
+    durationMinutes: source.durationMinutes,
+    targetIds: source.targets.map(({ targetId }) => targetId),
+    categoryRequirements: Object.fromEntries(CATEGORIES.map((key) => [key, source.categoryRequirements[key] ?? 0])),
+  };
+  const json = JSON.stringify(recipe, null, 2);
+  decodePortablePlan(json);
+  return json;
+}
diff --git a/tests/portable-plan-ui.test.js b/tests/portable-plan-ui.test.js
new file mode 100644
index 0000000..1d54ece
--- /dev/null
+++ b/tests/portable-plan-ui.test.js
@@ -0,0 +1,78 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { formatPortableTime, previewPortableAtLocation } from "../src/portable-plan-ui.js";
+
+const utc = "2026-08-29T01:00:00.000Z";
+const location = { latitude: 40.7128, longitude: -74.006, locationName: "Fixture observer" };
+const recipe = {
+  format: "night-sky-atlas/plan-recipe", version: 1, startTimeUtc: utc, audience: "general",
+  durationMinutes: 25, targetIds: ["star-vega", "star-deneb"],
+  categoryRequirements: { planet: 0, bright_star: 2, deep_sky: 0 },
+};
+test("labels the unchanged instant and the browser zone, not an original calendar zone", () => {
+  assert.match(formatPortableTime(utc, "America/Los_Angeles"), /2026-08-29T01:00:00.000Z.*America\/Los_Angeles.*Aug 28, 2026.*6:00 PM/);
+});
+test("import previews the shared UTC and IDs against only the local observer", () => {
+  const preview = previewPortableAtLocation(JSON.stringify(recipe), location);
+  assert.equal(preview.context.date, utc);
+  assert.equal(preview.context.locationName, location.locationName);
+  assert.deepEqual(preview.targets.map((target) => target.targetId), recipe.targetIds);
+  assert.deepEqual(preview.targets.map((target) => target.scheduledTime), [utc, "2026-08-29T01:13:00.000Z"]);
+  assert.throws(() => previewPortableAtLocation(JSON.stringify({ ...recipe, version: 9 }), location),
+    { code: "UNSUPPORTED_PORTABLE_PLAN_VERSION" });
+  assert.throws(() => previewPortableAtLocation(JSON.stringify({ ...recipe, targetIds: ["not-in-catalog", "star-deneb"] }), location),
+    { code: "TARGET_NOT_FOUND" });
+});
+
+test("manual controls preview export and import without writing the saved plan", async () => {
+  const { mountPortablePlanUi } = await import("../src/portable-plan-ui.js");
+  class FakeNode extends EventTarget {
+    textContent = "";
+    value = "";
+    hidden = false;
+    focused = false;
+    children = [];
+    focus() { this.focused = true; }
+    replaceChildren() { this.children = []; }
+    append(child) { this.children.push(child); }
+  }
+  const nodes = new Map([
+    "portableResult", "portableTargets", "portableInput", "portableOutputGroup", "portableOutput",
+    "portableExportTime", "portableExport", "portableImport",
+  ].map((id) => [id, new FakeNode()]));
+  const node = (id) => nodes.get(id);
+  const root = Object.assign(new FakeNode(), {
+    open: true,
+    querySelector: (selector) => node(selector.slice(1)),
+    ownerDocument: { createElement: () => new FakeNode() },
+  });
+  let plan = null;
+  const ui = mountPortablePlanUi({ root, getPlan: () => plan, getLocation: () => location });
+  const click = (id) => node(id).dispatchEvent(new Event("click"));
+  click("portableExport");
+  assert.match(node("portableResult").textContent, /Save a plan/);
+  plan = { ...previewPortableAtLocation(JSON.stringify(recipe), location), title: "Private Title", notes: "Private Notes" };
+  const original = structuredClone(plan);
+  click("portableExport");
+  const json = node("portableOutput").value;
+  assert.equal(node("portableOutput").focused, true);
+  assert.equal(node("portableOutputGroup").hidden, false);
+  assert.doesNotMatch(json, /Private|Fixture observer|40\.7128|-74\.006/);
+  assert.match(node("portableExportTime").textContent, /UTC:.*Browser time/);
+  node("portableInput").value = json;
+  click("portableImport");
+  assert.match(node("portableResult").textContent, /Preview for Fixture observer.*No plan was saved or replaced/);
+  assert.equal(node("portableTargets").children.length, 2);
+  for (const invalid of ["bogus", JSON.stringify({ ...recipe, version: 9 })]) {
+    node("portableInput").value = invalid;
+    click("portableImport");
+    assert.match(node("portableResult").textContent, /Cannot preview/);
+    assert.equal(node("portableTargets").children.length, 0);
+    assert.deepEqual(plan, original);
+  }
+  ui.close();
+  assert.equal(root.open, false);
+  assert.equal(node("portableInput").value, "");
+  assert.equal(node("portableOutput").value, "");
+  assert.equal(node("portableOutputGroup").hidden, true);
+});
diff --git a/tests/portable-plan.test.js b/tests/portable-plan.test.js
new file mode 100644
index 0000000..e1d5ca2
--- /dev/null
+++ b/tests/portable-plan.test.js
@@ -0,0 +1,82 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { buildCatalogAt, previewObservingPlan } from "../src/observing.js";
+import { decodePortablePlan, encodePortablePlan } from "../src/portable-plan.js";
+
+const context = {
+  date: "2026-08-29T01:00:00.000Z",
+  latitude: 40.7128,
+  longitude: -74.006,
+  locationName: "Synthetic location",
+};
+const catalog = buildCatalogAt(context.date);
+const current = previewObservingPlan(catalog, {
+  context, previewId: "browser-local-id", now: context.date,
+  title: "Private title", notes: "Private notes", audience: "general",
+  durationMinutes: 25, targetIds: ["star-vega", "star-deneb"],
+  minAltitude: 0, categoryRequirements: { planet: 0, bright_star: 2, deep_sky: 0 },
+});
+
+test("portable recipe carries schedule and ordered IDs but serializes no private fields or derived location data", () => {
+  const source = structuredClone(current);
+  source.context.private = { latitude: 1, longitude: 2, notes: "Nested private context" };
+  source.targets[0].private = { notes: "Nested private target" };
+  const before = structuredClone(source);
+  const json = encodePortablePlan(source, catalog);
+  assert.deepEqual(JSON.parse(json), {
+    format: "night-sky-atlas/plan-recipe",
+    version: 1,
+    startTimeUtc: context.date,
+    audience: "general",
+    durationMinutes: 25,
+    targetIds: ["star-vega", "star-deneb"],
+    categoryRequirements: { planet: 0, bright_star: 2, deep_sky: 0 },
+  });
+  assert.doesNotMatch(json, /40\.7128|-74\.006|Private|Nested|Synthetic location|browser-local-id|minimumAltitude|azimuth/i);
+  assert.deepEqual(source, before);
+});
+
+test("decoded recipe can reproduce IDs and slots with the existing planner and caller-supplied location", () => {
+  const recipe = decodePortablePlan(encodePortablePlan(current, catalog));
+  const replica = previewObservingPlan(catalog, {
+    context: { ...context, date: recipe.startTimeUtc }, previewId: "fresh-id",
+    now: recipe.startTimeUtc, title: "Shared plan", audience: recipe.audience,
+    durationMinutes: recipe.durationMinutes, targetIds: recipe.targetIds,
+    categoryRequirements: recipe.categoryRequirements, minAltitude: 0,
+  });
+  const slots = (plan) => plan.targets.map(({ targetId, scheduledTime }) => [targetId, scheduledTime]);
+  assert.deepEqual(slots(replica), slots(current));
+  assert.notEqual(replica.id, current.id);
+});
+
+test("malformed or hostile imports fail without mutating an active plan or catalog", () => {
+  const json = encodePortablePlan(current, catalog);
+  const good = JSON.parse(json);
+  const priorPlan = structuredClone(current);
+  const priorCatalog = structuredClone(catalog);
+  const invalid = [
+    null, "{}", "{broken", " ".repeat(4097),
+    json.replace(/}$/, ',"__proto__":{"polluted":true}}'),
+    JSON.stringify({ ...good, notes: "extra" }),
+    JSON.stringify({ ...good, context: { latitude: 1 } }),
+    JSON.stringify({ ...good, startTimeUtc: "2026-02-30T01:00:00.000Z" }),
+    JSON.stringify({ ...good, startTimeUtc: "2026-08-29T01:00:00" }),
+    JSON.stringify({ ...good, targetIds: ["star-vega", "star-vega"] }),
+    JSON.stringify({ ...good, categoryRequirements: { ...good.categoryRequirements, planet: 1 } }),
+    JSON.stringify({ ...good, categoryRequirements: { ...good.categoryRequirements, notes: "extra" } }),
+  ];
+  for (const candidate of invalid) {
+    assert.throws(() => decodePortablePlan(candidate), { code: "INVALID_PORTABLE_PLAN" });
+  }
+  assert.throws(
+    () => decodePortablePlan(JSON.stringify({ ...good, version: 2 })),
+    { code: "UNSUPPORTED_PORTABLE_PLAN_VERSION" },
+  );
+  assert.deepEqual(current, priorPlan);
+  assert.deepEqual(catalog, priorCatalog);
+  assert.equal({}.polluted, undefined);
+});
+
+test("export rejects targets that are not in the supplied catalog", () => {
+  assert.throws(() => encodePortablePlan(current, []), { code: "TARGET_NOT_FOUND" });
+});
